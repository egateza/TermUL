<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.egateza.termul</groupId>
        <artifactId>termul-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>termul-app</artifactId>
    <name>TermUL :: app</name>
    <description>Swing UI, wiring, main()</description>

    <dependencies>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-vault</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-ssh</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-terminal</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-sftp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.jediterm</groupId>
            <artifactId>jediterm-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-ssh</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.egateza.termul</groupId>
            <artifactId>termul-sftp</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <termul.mainClass>dev.egateza.termul.app.TermULApp</termul.mainClass>
        <!-- major.minor versi aplikasi; build number (jumlah commit git) ditambahkan saat build → mis. 0.1.105 -->
        <termul.versionBase>0.1</termul.versionBase>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- hanya build.properties yang di-filter (versi + commit dari git-commit-id-maven-plugin) -->
            <resource>
                <directory>src/main/build-info</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${termul.mainClass}</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>libs/</classpathPrefix>
                        </manifest>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${termul.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Distribusi Windows: jlink (runtime ramping) + jpackage.
              mvnw.cmd -Ppackage-win -DskipTests package                       → app-image (folder portable)
              mvnw.cmd -Ppackage-win -DskipTests package -Djpackage.type=msi   → installer .msi (butuh WiX di PATH)
            Hasil di app/target/dist/.
        -->
        <profile>
            <id>package-win</id>
            <properties>
                <jpackage.type>app-image</jpackage.type>
                <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
                <jpackage.dest>${project.build.directory}/dist</jpackage.dest>
                <!-- versi numerik untuk Windows (major.minor.build, build ≤ 65535) -->
                <jpackage.appVersion>${termul.versionBase}.${git.total.commit.count}</jpackage.appVersion>
                <!-- jdeps (lihat docs/SETUP.md) + jdk.unsupported (Unsafe reflektif) + jdk.localedata (locale id) -->
                <jpackage.modules>java.base,java.desktop,java.management,jdk.management,java.naming,java.prefs,java.rmi,java.security.jgss,java.sql,jdk.unsupported,jdk.localedata</jpackage.modules>
                <jpackage.installerArgs/>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jpackage.input}/libs</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-main-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <!-- jpackage menolak folder tujuan yang sudah berisi app-image lama -->
                            <execution>
                                <id>jpackage-clean-dist</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${jpackage.dest}</directory>
                                        </fileset>
                                        <fileset>
                                            <directory>${jpackage.input}</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <commandlineArgs>--type ${jpackage.type} --name TermUL --app-version ${jpackage.appVersion} --vendor egateza --description "SSH client pribadi" --input "${jpackage.input}" --main-jar ${project.build.finalName}.jar --main-class ${termul.mainClass} --dest "${jpackage.dest}" --icon "${project.basedir}/src/main/packaging/termul.ico" --add-modules ${jpackage.modules} --jlink-options "--strip-debug --no-man-pages --no-header-files --include-locales=en,id" --java-options --enable-native-access=ALL-UNNAMED ${jpackage.installerArgs}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- opsi installer, aktif otomatis bersama -Djpackage.type=msi -->
        <profile>
            <id>package-win-msi</id>
            <activation>
                <property>
                    <name>jpackage.type</name>
                    <value>msi</value>
                </property>
            </activation>
            <properties>
                <jpackage.installerArgs>--win-menu --win-menu-group TermUL --win-shortcut --win-dir-chooser --win-per-user-install --win-upgrade-uuid 3f6f8e2c-3b9e-4a52-9d53-7a1c2f0b9e41</jpackage.installerArgs>
            </properties>
        </profile>
    </profiles>
</project>
