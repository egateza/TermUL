<configuration>
    <!-- Log aplikasi: TANPA secret dan tanpa konten terminal (lihat docs/SECURITY.md) -->
    <property name="LOG_DIR" value="${myterm.logDir:-logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/myterm.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/myterm.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Panel log di UI (menu Bantuan → Tampilkan log): ring buffer di memori, isi sama dengan file log -->
    <appender name="UI" class="dev.egateza.myterm.app.log.UiLogAppender">
        <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </appender>

    <logger name="org.apache.sshd" level="WARN"/>
    <logger name="com.jediterm" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="UI"/>
    </root>
</configuration>
